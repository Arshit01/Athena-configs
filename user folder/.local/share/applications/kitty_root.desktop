[Desktop Entry]
Comment[en_US]=
Comment=
Exec= pkexec env "XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" "WAYLAND_DISPLAY=$WAYLAND_DISPLAY" kitty
GenericName[en_US]=
GenericName=Terminal emulator
Icon=gksu-root-terminal
MimeType=
Name[en_US]=kitty root
Name=kitty root (Terminal emulator)
NoDisplay=false
Path=
PrefersNonDefaultGPU=false
StartupNotify=true
Terminal=false
TerminalOptions=
Type=Application
X-KDE-SubstituteUID=false
X-KDE-Username=
